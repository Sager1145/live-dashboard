{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "serverInstanceID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schemaVersions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number",
            "const": 1
          },
          {
            "type": "number",
            "const": 2
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    }
  },
  "required": [
    "serverInstanceID",
    "schemaVersions",
    "capabilities"
  ],
  "additionalProperties": false
}
