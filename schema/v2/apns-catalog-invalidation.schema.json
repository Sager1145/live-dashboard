{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "aps": {
      "type": "object",
      "properties": {
        "content-available": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "content-available"
      ],
      "additionalProperties": false
    },
    "serverInstanceID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "catalogWatermark": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "required": [
    "aps",
    "serverInstanceID",
    "catalogWatermark"
  ],
  "additionalProperties": false
}
